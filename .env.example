# Copy to `.env` next to docker-compose.yml and fill in the values you need.
# Empty values are omitted by Watchtower (same as not setting the variable).

# Time zone used for logs and --schedule / WATCHTOWER_SCHEDULE
TZ=UTC

# Remove old images after a successful update
WATCHTOWER_CLEANUP=true

# How often to check for new images, in seconds (86400 = 24 hours)
WATCHTOWER_POLL_INTERVAL=86400

# Optional cron schedule. When set, this takes precedence over the poll interval.
# Example: "0 0 4 * * *" (every day at 04:00)
# WATCHTOWER_SCHEDULE=

# Notifications: Apprise is bundled in the image. No extra Apprise container is required.
# Space-separated Apprise URLs. See https://github.com/caronc/apprise/wiki
# Examples:
#   discord://webhook_id/webhook_token
#   tgram://bot_token/chat_id
#   mailto://user:app_password@gmail.com
# WATCHTOWER_NOTIFICATION_URL=

# Use the session report as notification body (recommended)
WATCHTOWER_NOTIFICATION_REPORT=true

# Optional path *inside the container* to an Apprise config file (mount it as a volume)
# WATCHTOWER_NOTIFICATION_APPRISE_CONFIG=/config/apprise.yml

# Only send a notification when something was updated or failed (default template behavior)
# WATCHTOWER_NO_STARTUP_MESSAGE=true

# Restrict which containers are updated (space-separated names as command args, or labels)
# WATCHTOWER_LABEL_ENABLE=true

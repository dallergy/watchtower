# Builds Watchtower from a published version, without needing a local checkout:
#
#   docker build -f Dockerfile.self-contained --build-arg WATCHTOWER_VERSION=main -t watchtower .
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS builder

# use a version tag (for example "v1.8.0") or "main"
ARG WATCHTOWER_VERSION=main
ARG WATCHTOWER_REPO=https://github.com/dallergy/watchtower.git
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT

RUN apk add --no-cache git
RUN git clone --depth 1 --branch "${WATCHTOWER_VERSION}" "${WATCHTOWER_REPO}" /src

WORKDIR /src
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOARM=${TARGETVARIANT#v} \
    go build -trimpath -tags timetzdata \
      -ldflags "-s -w -X github.com/dallergy/watchtower/internal/meta.Version=${WATCHTOWER_VERSION}" \
      -o /out/watchtower .

FROM scratch

LABEL "com.centurylinklabs.watchtower"="true"

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/watchtower /watchtower

EXPOSE 8080

HEALTHCHECK CMD ["/watchtower", "--health-check"]

ENTRYPOINT ["/watchtower"]
